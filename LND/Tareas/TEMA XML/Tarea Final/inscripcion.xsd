<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="inscripcion">
        <xs:complexType>
            <xs:attribute name="id">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:pattern value="ENT-[0-9]{4}[A-Z]{2}"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>